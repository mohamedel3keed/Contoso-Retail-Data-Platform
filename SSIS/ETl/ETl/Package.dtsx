      ,[SellingAreaSize]
      ,[LastRemodelDate]
	  ,[GeographyType]
      ,[ContinentName]
      ,[CityName]
      ,[StateProvinceName]
      ,[RegionCountryName]
      ,s.[ETLLoadID]
      ,s.[LoadDate]
      ,s.[UpdateDate]
      ,s.[stg_BatchID]
      ,s.[stg_LoadDateTime]
  FROM [RetailDWH].[stg].[DimStore] s
LEFT JOIN [stg].[DimGeography] g
ON S.GeographyKey = g.GeographyKey</property>
