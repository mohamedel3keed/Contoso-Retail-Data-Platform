                <component
                  refId="Package\Facts\dwh_FactOnlineSales\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    OnlineSalesKey,
    CONVERT(int, CONVERT(char(8), DateKey, 112))                         AS DateKeyInt,
    StoreKey,
    ProductKey,
    PromotionKey,
    CurrencyKey,
    CustomerKey,
    SalesOrderNumber,
    SalesOrderLineNumber,
    SalesQuantity,
    ReturnQuantity,
    DiscountQuantity,
    UnitCost,
    UnitPrice,
    SalesAmount,
    ReturnAmount,
    DiscountAmount,
    TotalCost,
    CAST(SalesQuantity AS decimal(19,4)) * UnitPrice                     AS GrossAmount,
    SalesAmount - ReturnAmount                                           AS NetAfterReturns,
    SalesAmount - TotalCost                                              AS Profit,
    CASE WHEN SalesAmount = 0 THEN NULL
         ELSE CAST((SalesAmount - TotalCost) / CAST(SalesAmount AS decimal(19,4)) AS decimal(9,4))
    END                                                                  AS ProfitMargin,
    CASE WHEN SalesQuantity * UnitPrice = 0 THEN NULL
         ELSE CAST(DiscountAmount / (CAST(SalesQuantity AS decimal(19,4)) * UnitPrice) AS decimal(9,4))
    END                                                                  AS DiscountPct,
    CASE WHEN SalesAmount &gt;= 5000 THEN N'Large'
         WHEN SalesAmount &gt;= 1000 THEN N'Medium'
         ELSE N'Small' END                                               AS SalesCategory,
    CASE WHEN SalesAmount - TotalCost &lt; 0 THEN N'Loss'
         WHEN SalesAmount = 0 THEN N'Low'
         WHEN (SalesAmount - TotalCost) / CAST(SalesAmount AS decimal(19,4)) &lt; 0.2 THEN N'Low'
         ELSE N'High' END                                                AS ProfitBand
FROM stg.FactOnlineSales
WHERE OnlineSalesKey &gt; ?  AND ISNULL(stg_IsValid, 1) = 1;</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
