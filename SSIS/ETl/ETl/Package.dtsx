        <DTS:Executable
          DTS:refId="Package\Facts\Validate FactInventory"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{26a698c0-117a-4d2f-9280-b58211de0923}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Validate FactInventory"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CB9A63C7-CAA9-4558-A4AA-97815E585196}"
              SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @LastKey     int           = ?;&#xA;DECLARE @BatchID     int           = ?;&#xA;DECLARE @PackageName nvarchar(200) = ?;&#xA;&#xA;-- 1) Re-run safety&#xA;DELETE etl.ErrorRecords&#xA;WHERE SourceTable = N'FactInventory'&#xA;  AND ProcessingStage = N'Validation'&#xA;  AND BatchID = @BatchID;&#xA;&#xA;DELETE etl.DataQualityMetrics&#xA;WHERE SourceTable = N'FactInventory'&#xA;  AND ProcessingStage = N'Validation'&#xA;  AND BatchID = @BatchID;&#xA;&#xA;UPDATE stg.FactInventory SET stg_IsValid = NULL&#xA;WHERE InventoryKey &gt; @LastKey AND stg_IsValid IS NOT NULL;&#xA;&#xA;-- 2) Find invalid rows&#xA;SELECT InventoryKey, ErrorReason, ErrorColumn&#xA;INTO #bad&#xA;FROM&#xA;(&#xA;    SELECT s.InventoryKey,&#xA;&#xA;        CASE&#xA;            WHEN s.DateKey IS NULL&#xA;                THEN N'DateKey is NULL'&#xA;            WHEN s.StoreKey IS NULL&#xA;                THEN N'StoreKey is NULL'&#xA;            WHEN s.ProductKey IS NULL&#xA;                THEN N'ProductKey is NULL'&#xA;            WHEN s.OnHandQuantity &lt; 0&#xA;                THEN N'OnHandQuantity is negative'&#xA;            WHEN s.OnOrderQuantity &lt; 0&#xA;                THEN N'OnOrderQuantity is negative'&#xA;            WHEN s.SafetyStockQuantity &lt; 0&#xA;                THEN N'SafetyStockQuantity is negative'&#xA;            WHEN s.UnitCost &lt; 0&#xA;                THEN N'UnitCost is negative'&#xA;            WHEN s.DaysInStock &lt; 0&#xA;                THEN N'DaysInStock is negative'&#xA;            WHEN s.MinDayInStock &lt; 0&#xA;                THEN N'MinDayInStock is negative'&#xA;            WHEN s.MaxDayInStock &lt; 0&#xA;                THEN N'MaxDayInStock is negative'&#xA;            WHEN s.MinDayInStock IS NOT NULL&#xA;             AND s.MaxDayInStock IS NOT NULL&#xA;             AND s.MaxDayInStock &lt; s.MinDayInStock&#xA;                THEN N'MaxDayInStock is less than MinDayInStock'&#xA;           WHEN s.DateKey &gt; GETDATE()&#xA;                THEN N'DateKey is in the future'&#xA;            WHEN d.DateKey IS NOT NULL&#xA;                THEN N'Duplicate inventory grain'&#xA;        END AS ErrorReason,&#xA;&#xA;        CASE&#xA;            WHEN s.DateKey IS NULL&#xA;                THEN N'DateKey'&#xA;            WHEN s.StoreKey IS NULL&#xA;                THEN N'StoreKey'&#xA;            WHEN s.ProductKey IS NULL&#xA;                THEN N'ProductKey'&#xA;            WHEN s.OnHandQuantity &lt; 0&#xA;                THEN N'OnHandQuantity'&#xA;            WHEN s.OnOrderQuantity &lt; 0&#xA;                THEN N'OnOrderQuantity'&#xA;            WHEN s.SafetyStockQuantity &lt; 0&#xA;                THEN N'SafetyStockQuantity'&#xA;            WHEN s.UnitCost &lt; 0&#xA;                THEN N'UnitCost'&#xA;            WHEN s.DaysInStock &lt; 0&#xA;                THEN N'DaysInStock'&#xA;            WHEN s.MinDayInStock &lt; 0&#xA;                THEN N'MinDayInStock'&#xA;            WHEN s.MaxDayInStock &lt; 0&#xA;                THEN N'MaxDayInStock'&#xA;            WHEN s.MinDayInStock IS NOT NULL&#xA;             AND s.MaxDayInStock IS NOT NULL&#xA;             AND s.MaxDayInStock &lt; s.MinDayInStock&#xA;                THEN N'MaxDayInStock'&#xA;            WHEN s.DateKey &gt; GETDATE()&#xA;                THEN N'DateKey'&#xA;            WHEN d.DateKey IS NOT NULL&#xA;                THEN N'DateKey, StoreKey, ProductKey'&#xA;        END AS ErrorColumn&#xA;&#xA;    FROM stg.FactInventory AS s&#xA;&#xA;    LEFT JOIN&#xA;    (&#xA;        SELECT DateKey, StoreKey, ProductKey&#xA;        FROM stg.FactInventory&#xA;        WHERE InventoryKey &gt; @LastKey&#xA;        GROUP BY DateKey, StoreKey, ProductKey&#xA;        HAVING COUNT(*) &gt; 1&#xA;    ) AS d&#xA;        ON d.DateKey = s.DateKey&#xA;       AND d.StoreKey = s.StoreKey&#xA;       AND d.ProductKey = s.ProductKey&#xA;&#xA;    WHERE s.InventoryKey &gt; @LastKey&#xA;) AS x&#xA;WHERE ErrorReason IS NOT NULL;&#xA;&#xA;-- 3) Log rejected rows&#xA;INSERT etl.ErrorRecords&#xA;(&#xA;    RecordID, SourceTable, ErrorReason, ErrorColumn,&#xA;    ProcessingStage, BatchID, PackageName&#xA;)&#xA;SELECT&#xA;    CAST(InventoryKey AS nvarchar(100)),&#xA;    N'FactInventory',&#xA;    ErrorReason,&#xA;    ErrorColumn,&#xA;    N'Validation',&#xA;    @BatchID,&#xA;    @PackageName&#xA;FROM #bad;&#xA;&#xA;-- 4) Mark rejected rows&#xA;UPDATE s&#xA;SET stg_IsValid = 0&#xA;FROM stg.FactInventory AS s&#xA;INNER JOIN #bad AS b&#xA;    ON b.InventoryKey = s.InventoryKey;&#xA;&#xA;-- 5) Metrics&#xA;DECLARE @total bigint =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.FactInventory&#xA;    WHERE InventoryKey &gt; @LastKey&#xA;);&#xA;&#xA;DECLARE @rejected bigint =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.FactInventory&#xA;    WHERE InventoryKey &gt; @LastKey&#xA;      AND stg_IsValid = 0&#xA;);&#xA;&#xA;&#xA;BEGIN&#xA;    INSERT etl.DataQualityMetrics&#xA;    (&#xA;        BatchID, SourceTable, ProcessingStage,&#xA;        TotalRecords, ValidRecords, RejectedRecords&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        @BatchID, N'FactInventory', N'Validation',&#xA;        @total, @total - @rejected, @rejected&#xA;    );&#xA;END;&#xA;&#xA;DROP TABLE #bad;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LastKey_FactInventory"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::Batch_ID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="System::PackageName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Facts\Validate FactOnlineSales"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3776c3f3-0ad7-42e1-91da-eaf4019ea071}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Validate FactOnlineSales"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CB9A63C7-CAA9-4558-A4AA-97815E585196}"
              SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @LastKey     int           = ?;&#xA;DECLARE @BatchID     int           = ?;&#xA;DECLARE @PackageName nvarchar(200) = ?;&#xA;&#xA;-- 1) Re-run safety&#xA;DELETE etl.ErrorRecords&#xA;WHERE SourceTable = N'FactOnlineSales'&#xA;  AND ProcessingStage = N'Validation'&#xA;  AND BatchID = @BatchID;&#xA;&#xA;DELETE etl.DataQualityMetrics&#xA;WHERE SourceTable = N'FactOnlineSales'&#xA;  AND ProcessingStage = N'Validation'&#xA;  AND BatchID = @BatchID;&#xA;&#xA;UPDATE stg.FactOnlineSales SET stg_IsValid = NULL&#xA;WHERE OnlineSalesKey &gt; @LastKey AND stg_IsValid IS NOT NULL;&#xA;&#xA;-- 2) Find invalid rows&#xA;SELECT OnlineSalesKey, ErrorReason, ErrorColumn&#xA;INTO #bad&#xA;FROM&#xA;(&#xA;    SELECT s.OnlineSalesKey,&#xA;&#xA;        CASE&#xA;            WHEN s.DateKey IS NULL&#xA;                THEN N'DateKey is NULL'&#xA;            WHEN s.StoreKey IS NULL&#xA;                THEN N'StoreKey is NULL'&#xA;            WHEN s.ProductKey IS NULL&#xA;                THEN N'ProductKey is NULL'&#xA;            WHEN s.CustomerKey IS NULL&#xA;                THEN N'CustomerKey is NULL'&#xA;            WHEN s.SalesOrderNumber IS NULL&#xA;                THEN N'SalesOrderNumber is NULL'&#xA;            WHEN s.SalesOrderLineNumber IS NULL&#xA;                THEN N'SalesOrderLineNumber is NULL'&#xA;            WHEN s.SalesQuantity &lt; 0&#xA;                THEN N'SalesQuantity is negative'&#xA;            WHEN s.ReturnQuantity &lt; 0&#xA;                THEN N'ReturnQuantity is negative'&#xA;            WHEN s.DiscountQuantity &lt; 0&#xA;                THEN N'DiscountQuantity is negative'&#xA;            WHEN s.ReturnQuantity &gt; s.SalesQuantity&#xA;                THEN N'ReturnQuantity exceeds SalesQuantity'&#xA;            WHEN s.DiscountQuantity &gt; s.SalesQuantity&#xA;                THEN N'DiscountQuantity exceeds SalesQuantity'&#xA;            WHEN s.SalesAmount &lt; 0&#xA;                THEN N'SalesAmount is negative'&#xA;            WHEN s.ReturnAmount &lt; 0&#xA;                THEN N'ReturnAmount is negative'&#xA;            WHEN s.DiscountAmount &lt; 0&#xA;                THEN N'DiscountAmount is negative'&#xA;            WHEN s.TotalCost &lt; 0&#xA;                THEN N'TotalCost is negative'&#xA;            WHEN s.UnitCost &lt; 0&#xA;                THEN N'UnitCost is negative'&#xA;            WHEN s.UnitPrice &lt; 0&#xA;                THEN N'UnitPrice is negative'&#xA;            WHEN s.DiscountAmount &gt;&#xA;                 CAST(s.SalesQuantity AS decimal(19,4)) * s.UnitPrice&#xA;                THEN N'DiscountAmount exceeds GrossAmount'&#xA;            WHEN s.DateKey &gt; GETDATE()&#xA;&#x9;&#x9;&#x9;&#x9;THEN N'DateKey is in the future'&#xA;            WHEN d.SalesOrderNumber IS NOT NULL&#xA;                THEN N'Duplicate order line'&#xA;        END AS ErrorReason,&#xA;&#xA;        CASE&#xA;            WHEN s.DateKey IS NULL&#xA;                THEN N'DateKey'&#xA;            WHEN s.StoreKey IS NULL&#xA;                THEN N'StoreKey'&#xA;            WHEN s.ProductKey IS NULL&#xA;                THEN N'ProductKey'&#xA;            WHEN s.CustomerKey IS NULL&#xA;                THEN N'CustomerKey'&#xA;            WHEN s.SalesOrderNumber IS NULL&#xA;                THEN N'SalesOrderNumber'&#xA;            WHEN s.SalesOrderLineNumber IS NULL&#xA;                THEN N'SalesOrderLineNumber'&#xA;            WHEN s.SalesQuantity &lt; 0&#xA;                THEN N'SalesQuantity'&#xA;            WHEN s.ReturnQuantity &lt; 0&#xA;                THEN N'ReturnQuantity'&#xA;            WHEN s.DiscountQuantity &lt; 0&#xA;                THEN N'DiscountQuantity'&#xA;            WHEN s.ReturnQuantity &gt; s.SalesQuantity&#xA;                THEN N'ReturnQuantity'&#xA;            WHEN s.DiscountQuantity &gt; s.SalesQuantity&#xA;                THEN N'DiscountQuantity'&#xA;            WHEN s.SalesAmount &lt; 0&#xA;                THEN N'SalesAmount'&#xA;            WHEN s.ReturnAmount &lt; 0&#xA;                THEN N'ReturnAmount'&#xA;            WHEN s.DiscountAmount &lt; 0&#xA;                THEN N'DiscountAmount'&#xA;            WHEN s.TotalCost &lt; 0&#xA;                THEN N'TotalCost'&#xA;            WHEN s.UnitCost &lt; 0&#xA;                THEN N'UnitCost'&#xA;            WHEN s.UnitPrice &lt; 0&#xA;                THEN N'UnitPrice'&#xA;            WHEN s.DiscountAmount &gt;&#xA;                 CAST(s.SalesQuantity AS decimal(19,4)) * s.UnitPrice&#xA;                THEN N'DiscountAmount'&#xA;            WHEN s.DateKey &gt; GETDATE()&#xA;                THEN N'DateKey'&#xA;            WHEN d.SalesOrderNumber IS NOT NULL&#xA;                THEN N'SalesOrderNumber, SalesOrderLineNumber'&#xA;        END AS ErrorColumn&#xA;&#xA;    FROM stg.FactOnlineSales AS s&#xA;&#xA;    LEFT JOIN&#xA;    (&#xA;        SELECT SalesOrderNumber, SalesOrderLineNumber&#xA;        FROM stg.FactOnlineSales&#xA;        WHERE OnlineSalesKey &gt; @LastKey&#xA;        GROUP BY SalesOrderNumber, SalesOrderLineNumber&#xA;        HAVING COUNT(*) &gt; 1&#xA;    ) AS d&#xA;        ON d.SalesOrderNumber = s.SalesOrderNumber&#xA;       AND d.SalesOrderLineNumber = s.SalesOrderLineNumber&#xA;&#xA;    WHERE s.OnlineSalesKey &gt; @LastKey&#xA;) AS x&#xA;WHERE ErrorReason IS NOT NULL;&#xA;&#xA;-- 3) Log rejected rows&#xA;INSERT etl.ErrorRecords&#xA;(&#xA;    RecordID, SourceTable, ErrorReason, ErrorColumn,&#xA;    ProcessingStage, BatchID, PackageName&#xA;)&#xA;SELECT&#xA;    CAST(OnlineSalesKey AS nvarchar(100)),&#xA;    N'FactOnlineSales',&#xA;    ErrorReason,&#xA;    ErrorColumn,&#xA;    N'Validation',&#xA;    @BatchID,&#xA;    @PackageName&#xA;FROM #bad;&#xA;&#xA;-- 4) Mark rejected rows&#xA;UPDATE s&#xA;SET stg_IsValid = 0&#xA;FROM stg.FactOnlineSales AS s&#xA;INNER JOIN #bad AS b&#xA;    ON b.OnlineSalesKey = s.OnlineSalesKey;&#xA;&#xA;-- 5) Metrics&#xA;DECLARE @total bigint =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.FactOnlineSales&#xA;    WHERE OnlineSalesKey &gt; @LastKey&#xA;);&#xA;&#xA;DECLARE @rejected bigint =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.FactOnlineSales&#xA;    WHERE OnlineSalesKey &gt; @LastKey&#xA;      AND stg_IsValid = 0&#xA;);&#xA;&#xA;BEGIN&#xA;    INSERT etl.DataQualityMetrics&#xA;    (&#xA;        BatchID, SourceTable, ProcessingStage,&#xA;        TotalRecords, ValidRecords, RejectedRecords&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        @BatchID, N'FactOnlineSales', N'Validation',&#xA;        @total, @total - @rejected, @rejected&#xA;    );&#xA;END;&#xA;&#xA;DROP TABLE #bad;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LastKey_FactOnlineSales"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::Batch_ID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="System::PackageName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Facts\Validate FactSales"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{07BBC68F-26FF-4BFE-AB04-1471E4F19363}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Validate FactSales"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CB9A63C7-CAA9-4558-A4AA-97815E585196}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @LastKey     int           = ?;&#xA;DECLARE @BatchID     int           = ?;&#xA;DECLARE @PackageName nvarchar(200) = ?;&#xA;&#xA;-- 1) re-run safety: clear what this batch wrote before, and reset the flag&#xA;DELETE etl.ErrorRecords&#xA; WHERE SourceTable = N'FactSales' AND ProcessingStage = N'Validation' AND BatchID = @BatchID;&#xA;DELETE etl.DataQualityMetrics&#xA; WHERE SourceTable = N'FactSales' AND ProcessingStage = N'Validation' AND BatchID = @BatchID;&#xA;UPDATE stg.FactSales SET stg_IsValid = NULL WHERE SalesKey &gt; @LastKey AND stg_IsValid IS NOT NULL;&#xA;&#xA;-- 2) find the bad rows (first failing rule wins)&#xA;SELECT SalesKey, ErrorReason, ErrorColumn&#xA;INTO #bad&#xA;FROM (&#xA;    SELECT s.SalesKey,&#xA;           CASE WHEN s.SalesQuantity  &lt; 0 THEN N'SalesQuantity is negative'&#xA;                WHEN s.UnitPrice      &lt; 0 THEN N'UnitPrice is negative'&#xA;                WHEN s.SalesAmount    &lt; 0 THEN N'SalesAmount is negative'&#xA;                WHEN s.DiscountAmount &lt; 0 THEN N'DiscountAmount is negative'&#xA;                WHEN s.DateKey &gt; GETDATE() THEN N'DateKey is in the future'&#xA;                WHEN s.DiscountAmount &gt; CAST(s.SalesQuantity AS decimal(19,4)) * s.UnitPrice&#xA;                                          THEN N'DiscountAmount exceeds the gross amount'&#xA;                WHEN d.SalesKey IS NOT NULL THEN N'Duplicate SalesKey'&#xA;           END AS ErrorReason,&#xA;           CASE WHEN s.SalesQuantity  &lt; 0 THEN N'SalesQuantity'&#xA;                WHEN s.UnitPrice      &lt; 0 THEN N'UnitPrice'&#xA;                WHEN s.SalesAmount    &lt; 0 THEN N'SalesAmount'&#xA;                WHEN s.DiscountAmount &lt; 0 THEN N'DiscountAmount'&#xA;                WHEN s.DateKey &gt; GETDATE() THEN N'DateKey'&#xA;                WHEN s.DiscountAmount &gt; CAST(s.SalesQuantity AS decimal(19,4)) * s.UnitPrice&#xA;                                          THEN N'DiscountAmount'&#xA;                WHEN d.SalesKey IS NOT NULL THEN N'SalesKey'&#xA;           END AS ErrorColumn&#xA;    FROM stg.FactSales AS s&#xA;    LEFT JOIN (SELECT SalesKey FROM stg.FactSales&#xA;               WHERE SalesKey &gt; @LastKey GROUP BY SalesKey HAVING COUNT(*) &gt; 1) AS d&#xA;           ON d.SalesKey = s.SalesKey&#xA;    WHERE s.SalesKey &gt; @LastKey&#xA;) AS x&#xA;WHERE ErrorReason IS NOT NULL;&#xA;&#xA;-- 3) rejected rows -&gt; etl.ErrorRecords&#xA;INSERT etl.ErrorRecords (RecordID, SourceTable, ErrorReason, ErrorColumn, ProcessingStage, BatchID, PackageName)&#xA;SELECT CAST(SalesKey AS nvarchar(100)), N'FactSales', ErrorReason, ErrorColumn,&#xA;       N'Validation', @BatchID, @PackageName&#xA;FROM #bad;&#xA;&#xA;-- 4) flag them in staging so the Data Flow skips them&#xA;UPDATE s&#xA;   SET stg_IsValid = 0&#xA;  FROM stg.FactSales AS s&#xA; WHERE s.SalesKey &gt; @LastKey&#xA;   AND s.SalesKey IN (SELECT SalesKey FROM #bad);&#xA;&#xA;-- 5) the numbers -&gt; etl.DataQualityMetrics&#xA;DECLARE @total    bigint = (SELECT COUNT(*) FROM stg.FactSales WHERE SalesKey &gt; @LastKey);&#xA;DECLARE @rejected bigint = (SELECT COUNT(*) FROM stg.FactSales WHERE SalesKey &gt; @LastKey AND stg_IsValid = 0);&#xA;&#xA;    INSERT etl.DataQualityMetrics (BatchID, SourceTable, ProcessingStage, TotalRecords, ValidRecords, RejectedRecords)&#xA;    VALUES (@BatchID, N'FactSales', N'Validation', @total, @total - @rejected, @rejected);&#xA;&#xA;DROP TABLE #bad;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::LastKey_FactSales"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::Batch_ID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="System::PackageName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
