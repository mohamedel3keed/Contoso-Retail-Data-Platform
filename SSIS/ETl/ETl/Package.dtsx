                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [ProductKey]
      ,[ProductName]
      ,[ProductDescription]
      ,[Manufacturer]
      ,[BrandName]
      ,[ClassName]
      ,[ColorName]
      ,[Size]
      ,[Weight]
      ,[StockTypeName]
      ,[UnitCost]
      ,[UnitPrice]
      ,[AvailableForSaleDate]
      ,[StopSaleDate]
      ,[Status]
      ,[ProductCategoryName] as CategoryName
      ,[ProductSubcategoryName] as SubcategoryName
      ,p.[ETLLoadID]
      ,p.[UpdateDate]
      ,p.[stg_BatchID]
      ,p.[stg_LoadDateTime]
  FROM [RetailDWH].[stg].[DimProduct] p
  LEFT JOIN [stg].[DimProductSubcategory] s
  ON P.ProductSubcategoryKey = s.ProductSubcategoryKey
  LEFT JOIN [stg].[DimProductCategory] c
  on s.ProductCategoryKey = c.ProductCategoryKey</property>
