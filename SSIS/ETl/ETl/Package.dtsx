                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT TOP (1000) [StoreKey]
      ,s.[GeographyKey]
      ,[StoreManager]
      ,[StoreType]
      ,[StoreName]
      ,[StoreDescription]
      ,[Status]
      ,[OpenDate]
      ,[CloseDate]
      ,[EntityKey]
      ,[ZipCode]
      ,[StorePhone]
